# Environment Variables
# Copy this file to .env.local and fill in your values.

# The base URL of your application (e.g. http://localhost:3000 for local dev)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Resend API Key for sending verification emails
# Get one at https://resend.com/
RESEND_API_KEY=re_your_resend_api_key

# Firebase Configuration
# Create a project at https://console.firebase.google.com/
# Add a web app and copy the config values here.
# Don't forget to enable Firestore Database!
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
